# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
# Which settings module to load: config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# --- Google OAuth2 (social login) ---
# From https://console.cloud.google.com/apis/credentials
client_id=your-google-oauth-client-id
client_secret=your-google-oauth-client-secret

# --- Email (password reset, notifications) ---
# For Gmail, use an App Password, not your normal account password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# --- Database (only read by config.settings.prod; dev uses SQLite) ---
DB_NAME=INMS
DB_USER=inms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Production only (config.settings.prod) ---
# Comma-separated list of domains this site is served from.
ALLOWED_HOSTS=example.com,www.example.com
